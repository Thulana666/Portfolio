# Optional: overrides `site.url` in data/site.js (e.g. a custom domain).
# Used for SEO, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (https://resend.com). Messages are emailed to
# CONTACT_TO_EMAIL. Both are required; without them the form shows an error.
# With Resend's shared sender (no domain verified), CONTACT_TO_EMAIL must be
# the email address you signed up to Resend with.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional: a sender on a domain you've verified in Resend.
# Defaults to Resend's shared sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=
