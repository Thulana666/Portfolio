# Public URL of the deployed site (used for SEO, Open Graph and sitemap).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (https://resend.com). The form only sends real
# messages when BOTH of these are set; otherwise it falls back to opening
# the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional: verified sender address on your Resend domain.
# Defaults to Resend's shared test sender.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
